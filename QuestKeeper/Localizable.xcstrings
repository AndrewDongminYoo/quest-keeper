    "dungeon.firstWin.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a small battle you can finish in two minutes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2분 안에 끝낼 수 있는 작은 전투부터 시작하세요."
          }
        }
      }
    },
