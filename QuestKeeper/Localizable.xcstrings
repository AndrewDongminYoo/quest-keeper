    "dungeon.empty.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one small battle to get started."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 전투 하나를 추가해 시작하세요."
