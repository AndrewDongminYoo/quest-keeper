    "monster.explanation.rulesBody" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You set importance when you create a quest, and the time left keeps moving. So the same quest meets a different monster as its deadline gets closer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요도는 퀘스트를 만들 때 정하고, 마감까지 남은 시간은 계속 움직입니다. 그래서 같은 퀘스트라도 마감이 다가오면 몬스터가 바뀝니다."
          }
        }
      }
    },
