# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Capture and validate deterministic ko and en-US App Store screenshots"
  lane :screenshots do
    sh("bash", "../scripts/validate-store-screenshot-reachability.sh")
    snapshot
    sh("bash", "../scripts/process-store-screenshots.sh")
    sh("bash", "../scripts/validate-store-screenshots.sh")
  end

  desc "Generate and validate What's New metadata for the current version"
  lane :release_notes do
    sh("bash", "../scripts/prepare-release-notes.sh")
  end

  desc "Prepare all local App Store assets without uploading"
  lane :store_assets do
    release_notes
    screenshots
  end

  # CURRENT_PROJECT_VERSION is set deliberately in the release commit and is
  # what the release tag names, so this lane must submit it unchanged.
  desc "Push a new release build to the App Store"
  lane :release do
    # A release cut while a rename is half-applied ships a listing whose title,
    # description and screenshots name different apps -- and which of the three
    # is stale depends only on which was edited first. Assert they agree before
    # doing any work, rather than guarding each of them separately.
    sh("bash", "../scripts/test-store-locale-brand.sh")
    # Deliver replaces the whole store set from the committed PNGs
    # (`overwrite_screenshots(true)` in the Deliverfile), and the dungeon header
    # is rendered into those images, so a stale one ships the wrong brand and no
    # gate can read it. Regenerate from the current build instead of trusting
    # whatever happens to be committed.
    screenshots
    # Reads APP_STORE_CONNECT_API_KEY_{KEY_ID,ISSUER_ID,KEY_FILEPATH} from the
    # environment so no account identifier or private key lives in this repo.
    # upload_to_app_store picks the key up from the lane context, which is what
    # authenticates altool for the binary upload.
    app_store_connect_api_key
    build_app(scheme: "QuestKeeper")
    upload_to_app_store
  end
end
